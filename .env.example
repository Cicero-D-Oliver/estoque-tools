# Copie para .env e troque a senha antes de usar Docker.
POSTGRES_DB=estoque_db
POSTGRES_USER=estoque
POSTGRES_PASSWORD=troque-esta-senha-antes-de-usar
APP_JWT_SECRET=
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=30d
APP_PASSWORD_RESET_TOKEN_TTL=30m
APP_MAX_FAILED_LOGIN_ATTEMPTS=5
APP_LOGIN_LOCK_DURATION=15m
APP_ALLOWED_EMAIL_DOMAINS=scaladatacenters.com
APP_PUBLIC_REGISTRATION_ENABLED=false
APP_INITIAL_ADMIN_EMAIL=admin@scaladatacenters.com
APP_INITIAL_ORGANIZATION_NAME=Almoxarifado principal
APP_PUBLIC_BASE_URL=https://estoque.example.com
APP_EMAIL_VERIFICATION_TOKEN_TTL=30m
APP_INVITATION_RESEND_COOLDOWN=5m
APP_MAIL_DELIVERY_MODE=smtp
APP_MAIL_FROM=estoque@scaladatacenters.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_READ_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000
MAIL_HEALTH_ENABLED=true
APP_REFRESH_COOKIE_SECURE=true
APP_REFRESH_COOKIE_SAME_SITE=Lax
APP_PORT=8080
CORS_ALLOWED_ORIGINS=https://estoque.example.com
CORS_ALLOW_CREDENTIALS=true
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
