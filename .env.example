# Copie para .env e troque a senha antes de usar Docker.
POSTGRES_DB=estoque_db
POSTGRES_USER=estoque
POSTGRES_PASSWORD=troque-esta-senha-antes-de-usar
APP_JWT_SECRET=
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=30d
APP_PASSWORD_RESET_TOKEN_TTL=30m
APP_MAX_FAILED_LOGIN_ATTEMPTS=5
APP_LOGIN_LOCK_DURATION=15m
APP_REFRESH_COOKIE_SECURE=true
APP_REFRESH_COOKIE_SAME_SITE=Lax
APP_PORT=8080
CORS_ALLOWED_ORIGINS=https://estoque.example.com
CORS_ALLOW_CREDENTIALS=true
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
